# Public browser-safe Supabase configuration. Never add service_role or OAuth secrets here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional compatibility name for projects still using legacy anon keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Canonical application URL used in deployment documentation and external dashboards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
